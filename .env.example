# PureAir Life - environment configuration
#
# Copy this file to `.env` and fill in your key. The server reads the
# variable from the process environment; the key is NEVER bundled into the
# browser build.
#
#   cp .env.example .env
#   # then export it before starting the server:
#   #   set GEMINI_API_KEY=your_key   (Windows PowerShell)
#   #   export GEMINI_API_KEY=...     (macOS / Linux)
#
# Get a key from https://aistudio.google.com/app/apikey

# Server-side Google AI Studio key. Required for live Gemini answers.
# Read by server/geminiProxy.js and sent upstream to Google only.
GEMINI_API_KEY=

# Optional: pin a specific Gemini model. When omitted the proxy walks a
# failover chain (gemini-3.8-flash -> 3.7 -> 3.5 -> 3.1-flash-lite) so a
# capacity-limited model does not break the request.
GEMINI_MODEL=gemini-3.8-flash

# Optional: HTTP port for the production server (default 8787).
PORT=8787

# Optional: bind address (default 127.0.0.1).
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Static-hosting fallback
# ---------------------------------------------------------------------------
# If you deploy the static build (`dist/`) to a host without the Node server,
# the assistant falls back to the bundled offline clean-air guide and shows an
# honest "AI offline" badge. Users can then paste their own Google AI Studio
# key from the provider badge in the header - that key is kept in
# `sessionStorage` for the browser tab only and is sent to Google directly.
#
# Do NOT put a key in a `VITE_*` variable for a public deployment: Vite
# inlines `VITE_*` values into the JavaScript bundle, which publishes them.
